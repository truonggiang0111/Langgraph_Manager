# Copy to .env when you wire a real model/provider.
# n8n should call this manager only for automation triggers, not for AI planning.
LANGGRAPH_MANAGER_ENV=local
LANGGRAPH_STATE_DIR=D:/User/File/reports/langgraph_manager
LANGGRAPH_WORKSPACE_ROOT=D:/User/File/LangGraph_Manager
CLAUDE_HOME_PATH=D:/User/File/ClaudeHome
CLAUDE_EXECUTOR_HOME_PATH=/home/node/.claude
CODEGRAPH_ENABLED=1
SKILL_DISCOVERY_MODE=guided
LANGGRAPH_PYTHON=python
LANGGRAPH_UI_URL=http://127.0.0.1:8899/api/health
CLIPROXY_BASE_URL=http://host.docker.internal:8317
CLIPROXY_MODEL=gpt-5.4
CLIPROXY_CHAT_MODEL=gpt-5.4
CLIPROXY_PLAN_MODEL=gpt-5.5
CLIPROXY_CHAT_MAX_TOKENS=700
CLIPROXY_API_KEY=
CLIPROXY_MANAGEMENT_PASSWORD=
CLIPROXY_TIMEOUT_SECONDS=180
CLAUDE_EXECUTOR_COMMAND=docker run --rm -i --entrypoint /usr/local/bin/claude-executor-entrypoint --user node -e HOME=/home/node -e NPM_CONFIG_CACHE=/home/node/.npm -e SSH_SOURCE_DIR=/ssh-host -e ANTHROPIC_BASE_URL=http://host.docker.internal:8082 -e ANTHROPIC_AUTH_TOKEN=freecc -e ANTHROPIC_API_KEY=freecc -e CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY=1 -e GIT_SSH_COMMAND=ssh -F /home/node/.ssh/config -o StrictHostKeyChecking=accept-new -v D:/User/File:/workspace -v D:/User/File/ClaudeHome:/home/node/.claude -v D:/User/File/ClaudeHome/.claude.json:/home/node/.claude.json -v C:/Users/giang/.ssh:/ssh-host:ro -w /workspace/LangGraph_Manager claude-executor-mcp:local -p --model gpt-5.4 --permission-mode bypassPermissions --tools default --add-dir /workspace --output-format text
CLAUDE_EXECUTOR_TIMEOUT=900
CUT_VIDEO_BRIDGE_URL=http://host.docker.internal:3337
CUT_VIDEO_BRIDGE_TOKEN=
N8N_BASE_URL=http://host.docker.internal:5678
N8N_WEBHOOK_TOKEN=
OPENCLAW_HOOK_URL=http://host.docker.internal:18789/hooks/agent
OPENCLAW_HOOK_TOKEN=
